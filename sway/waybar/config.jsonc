[{
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 18,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 5,
    "margin-right": 12,
    "modules-left": ["sway/workspaces"],
    "modules-center": [
            "custom/notification",
            "clock#time",
            "idle_inhibitor",
            "custom/pacman",
            "mpd"
    ],
    "modules-right": [
            "group/keyboard",
            "group/audio",
            "group/connectivity",
            "sway/language"
    ],
    "group/keyboard": {
        "orientation": "horizontal",
        "modules": ["keyboard-state#caps", "keyboard-state#num"]
    },
    "group/audio": {
        "orientation": "horizontal",
        "modules": ["pulseaudio#output", "pulseaudio#source"]
    },
    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth"]
    },
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{name}",
        "disable-scroll-wraparound": true,
        "numeric-first": true,
        "cursor": true
    },
    "custom/sep": {
        "format": "|",
        "tooltip": false
    },
    "clock#date": {
        "format": "{:%a %b %d}",
        "tooltip": false
    },
    "clock#time": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%Y-%m-%d %I:%M %p}",
        "tooltip-format": "<b>{:%A, %B %d, %Y}</b>\n<span size='14pt' font='JetBrainsMonoNL Nerd Font Mono'>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#d0d7de'><b>{}</b></span>",
                "days": "<span color='#d0d7de'>{}</span>",
                "weekdays": "<span color='#D29922'><b>{}</b></span>",
                "today": "<span color='#539bf5'><b><u>{}</u></b></span>"
            }
        }
    },
    "pulseaudio#output": {
		"format": "{icon} {volume}%",
        "format-muted": "<span color='#4e5b55'>muted</span>",
		"scroll-step": 2,
		"on-click-right": "pavucontrol",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"format-icons": ["", "", ""],
        "tooltip": false
	},
	"pulseaudio#source": {
		"format": "{format_source}",
		"format-source": " {volume}%",
		"format-source-muted": "<span color='#FF0000'></span> {volume}%",
		"on-click-right": "pavucontrol",
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5,
        "tooltip": false
	},
    "sway/language": {
        "format": "{short}",
        "format-en": "EN",
        "format-ru": "RU",
        "format-ge": "GE",
        "tooltip": false,
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },
    "keyboard-state#caps": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": " Caps ",
            "unlocked": ""
        }
    },
    "keyboard-state#num": {
        "numlock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": " Num ",
            "unlocked": ""
        }
    },
    "custom/notification": {
        "tooltip": false,
        "format": " {icon} ",
        "format-icons": {
            "notification": "<span foreground='#D29922'>󰂚</span>",
            "none": "<span foreground='#d0d7de'>󰂚</span>",
            "dnd-notification": "<span foreground='#D29922'>󰂛</span>",
            "dnd-none": "<span foreground='#d0d7de'>󰂛</span>",
            "inhibited-notification": "<span foreground='#D29922'>󰂚</span>",
            "inhibited-none": "<span foreground='#d0d7de'>󰂚</span>",
            "dnd-inhibited-notification": "<span foreground='#D29922'>󰂛</span>",
            "dnd-inhibited-none": "<span foreground='#d0d7de'>󰂛</span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb --skip-wait",
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d -sw",
        "escape": true,
        "restart-interval": 3
    },
    "idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": " ",
			"deactivated": " "
		},
		"icon-size": 16
    },
    "mpd": {
        "format": "  |{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{volume}%|",
        "format-disconnected": "Disconnected ",
        "format-stopped": " Stopped",
        "unknown-tag": "N/A",
        "interval": 3,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ ",
        "tooltip-format-disconnected": "MPD (disconnected)",
        "on-click": "mpc toggle",
        "on-click-right": "mpc stop"
    },
    "network": {
        "format-wifi": " ",
        "format-ethernet": " ",
        "format-disconnected": "󰤮 ",
        "format-disabled": " ",
        "tooltip-format": "{essid}",
        "on-click": "ghostty --title=nmtui -e 'nmtui'",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "  ",
        "format-connected": "  {num_connections}",
        "format-off": " 󰂲 ",
        "format-disabled": " 󰂲 ",
        "tooltip-format": "{status}",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo 'off' || echo 'on')"
    },
    "custom/pacman": {
        "format": "{}  ",
        "interval": "once",
        "exec": "checkupdates | wc -l",
        "exec-if": "exit 0",
        "on-click": "pkill -RTMIN+8 waybar",
        "on-click-right": "alacritty -e bash -lc '/usr/bin/checkupdates; echo; read -p \"Press Enter...\"'",
        "signal": 8,
        "tooltip": false
    }
},{
    "output": "eDP-1",
    "layer": "top",
    "position": "bottom",
    "exclusive": false,
    "height": 18,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": -5,
    "margin-bottom": -5,
    "modules-left": [],
    "modules-center": [],
    "modules-right": [
            "custom/powerprofile",
            "battery",
            "tray"
    ],
    "custom/powerprofile": {
        "format": "{}",
        "exec": "~/.config/powermodes/profile-status.sh",
        "tooltip": false,
        "interval": 5
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span color='#D29922'>BAT</span> {capacity}%",
        "format-charging": "<span color='#D29922'>CHG</span> {capacity}%",
        "format-plugged": "<span color='#D29922'>PLG</span> {capacity}%",
        "tooltip": true
    },
    "tray": {
        "spacing": 6,
        "icon-size": 18,
        "show-passive-items": false
    }
},{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 18,
    "spacing": 0,
    "margin-top": 0,
